{
  "name": "threepipe-blueprint-editor",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:agents && npm run build:app && npm run build:runtime",
    "build:agents": "node ./scripts/build-agents-md.mjs",
    "build:app": "tsc && vite build",
    "build:runtime": "vite build --config vite.runtime.config.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:runtime": "playwright test --config playwright.runtime.config.ts",
    "test:publish": "vitest run --config vitest.config.ts",
    "test:report": "playwright show-report",
    "deploy": "wrangler deploy && node ./scripts/register-runtime.mjs",
    "deploy:r2-legacy": "git diff --exit-code --name-only HEAD * && node -r dotenv/config ./scripts/upload-r2.mjs dist blitz-threepipe-v0/ && git tag v$npm_package_version",
    "deploy-tp": "git diff --exit-code --name-only HEAD * && node -r dotenv/config ./scripts/upload-r2.mjs dist threepipe-editor/ && git tag v$npm_package_version"
  },
  "dependencies": {
    "@threepipe/plugin-3d-tiles-renderer": "^0.3.2",
    "@threepipe/plugin-assimpjs": "^0.2.3",
    "@threepipe/plugin-blend-importer": "^0.1.0",
    "@threepipe/plugin-configurator": "^0.2.3",
    "@threepipe/plugin-gaussian-splatting": "^0.2.5",
    "@threepipe/plugin-geometry-generator": "^0.6.3",
    "@threepipe/plugin-gltf-transform": "^0.2.2",
    "@threepipe/plugin-network": "^0.1.5",
    "@threepipe/plugin-path-tracing": "^0.1.4",
    "@threepipe/plugin-troika-text": "^0.1.2",
    "@threepipe/plugins-extra-importers": "^0.2.5",
    "@threepipe/webgi-plugins": "^0.5.10",
    "blueprint-styler": "^5.0.2",
    "classnames": "2.5.1",
    "idb": "^8.0.0",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "stats.js": "^0.17.0",
    "threepipe": "0.5.1",
    "ts-browser-helpers": "0.19.4",
    "uiconfig-blueprint": "0.1.0-dev.14",
    "uiconfig.js": "^0.3.1"
  },
  "devDependencies": {
    "@blueprintjs/core": "^5.19.1",
    "@blueprintjs/select": "^5.3.21",
    "@playwright/test": "^1.57.0",
    "@repalash/popmotion": "^11.0.5002",
    "@rollup/plugin-replace": "^5.0.7",
    "@tanstack/query-db-collection": "^1.0.6",
    "@tanstack/react-db": "^0.1.55",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-virtual": "^3.13.13",
    "@types/node": "^22.1.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-basic-ssl": "^1.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "cannon-es": "^0.20.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "importmap-vite-plugin": "^0.1.0",
    "jsonc-parser": "^3.3.1",
    "rclone.js": "^0.6.6",
    "react-resizable-panels": "^3.0.6",
    "react-split": "^2.0.14",
    "sass": "^1.69.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "vite": "^6.3.5",
    "web-vitals": "^3.5.0",
    "zod": "^4.1.13"
  }
}
