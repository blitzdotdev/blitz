{
  "name": "@blitzdev/blitz",
  "version": "0.12.0",
  "description": "The Blitz command and secure localhost development server.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {"blitz": "./dist/cli.js"},
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "engines": {"node": ">=20"},
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:publish": "vitest run test/publish.test.ts"
  },
  "dependencies": {
    "@blitzdev/editor": "0.12.0",
    "@blitzdev/engine": "0.12.0",
    "@blitzdev/template": "0.12.0",
    "open": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.1.0",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
