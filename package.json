{
  "name": "threepipe-blueprint-editor",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "git diff --exit-code --name-only HEAD * && node -r dotenv/config ./scripts/upload-r2.mjs dist threepipe-editor/ && git tag v$npm_package_version"
  },
  "dependencies": {
    "@threepipe/webgi-plugins": "^0.5.5",
    "@threepipe/plugin-blend-importer": "^0.0.8",
    "@threepipe/plugin-gltf-transform": "^0.2.0",
    "@threepipe/plugin-network": "^0.1.3",
    "@threepipe/plugin-configurator": "^0.2.1",
    "@threepipe/plugin-gaussian-splatting": "^0.2.3",
    "@threepipe/plugin-geometry-generator": "^0.5.0",
    "@threepipe/plugins-extra-importers": "^0.2.3",
    "@threepipe/plugin-tweakpane-editor": "^0.4.5",
    "@threepipe/plugin-3d-tiles-renderer": "^0.3.0",
    "@threepipe/plugin-assimpjs": "^0.2.1",
    "@threepipe/plugin-path-tracing": "^0.1.2",

    "blueprint-styler": "^5.0.2",
    "idb": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stats.js": "^0.17.0",
    "threepipe": "^0.0.60",
    "uiconfig-blueprint": "^0.1.0-dev.9",
    "react-colorful": "^5.6.1",
    "classnames": "2.5.1",
    "uiconfig.js": "^0.2.1"
  },
  "devDependencies": {
    "@blueprintjs/core": "^5.11.0",
    "@rollup/plugin-replace": "^5.0.7",
    "@types/node": "^22.1.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-basic-ssl": "^1.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "rclone.js": "^0.6.6",
    "react-split": "^2.0.14",
    "sass": "^1.69.5",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "@types/wicg-file-system-access": "^2023.10.5",
    "web-vitals": "^3.5.0",
    "@repalash/popmotion": "^11.0.5002"
  },
  "overrides": {
    "threepipe": "$threepipe",
    "uiconfig.js": "$uiconfig.js"
  }
}
