{
  "name": "blitz",
  "version": "0.12.2",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@blueprintjs/colors": "5.1.9",
    "three": "https://github.com/repalash/three.js-modded/releases/download/v0.163.10003/package.tgz",
    "threepipe": {
      "@types/three": "$@types/three"
    },
    "@tanstack/db": "0.5.11",
    "@tanstack/query-db-collection": "1.0.6",
    "@tanstack/react-db": "0.1.55",
    "ts-browser-helpers": "0.19.4",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@blueprintjs/colors": "5.1.9",
    "@types/three": "https://github.com/repalash/three-ts-types/releases/download/v0.163.10003/package.tgz"
  },
  "scripts": {
    "build:threepipe": "npm run compile -w packages/threepipe",
    "build:ui": "npm run build -w packages/uiconfig-blueprint",
    "build:engine": "npm run build -w packages/engine",
    "build:editor": "npm run build -w packages/editor",
    "build:blitz": "npm run build -w packages/blitz",
    "build": "npm run build:threepipe && npm run build:ui && npm run build:engine && npm run build:editor && npm run build:blitz",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:runtime": "npm run test:runtime -w packages/engine",
    "test:gates": "npm run test:gates -w packages/engine",
    "test:publish": "npm run test:publish -w packages/blitz",
    "test:blitz": "npm test -w packages/blitz",
    "test:editor": "npm test -w packages/editor",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "npm run lint -w packages/engine && npm run lint -w packages/editor && npm run lint -w packages/blitz && npm run lint -w packages/template",
    "version:set": "node scripts/set-version.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release": "node scripts/release.mjs --publish",
    "release:patch": "node scripts/set-version.mjs patch && npm run release",
    "release:minor": "node scripts/set-version.mjs minor && npm run release",
    "release:major": "node scripts/set-version.mjs major && npm run release",
    "release:register": "node scripts/register-runtime.mjs",
    "dev:editor": "npm run dev -w packages/editor"
  }
}
