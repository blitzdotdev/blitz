{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blitz-game-gateway",
  "account_id": "d25a778b256fb6ef6eea554d77c40f27",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "dev": { "port": 8788 },
  "vars": { "APP_DOMAIN": "app.blitz.dev" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blitz-games-platform-db",
      "database_id": "a6bc6a7c-aed6-4072-a1ef-35b86cc1ac13"
    }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "blitz-games-blobs" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
