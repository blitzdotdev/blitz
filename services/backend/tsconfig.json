{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ESNext"],
    "types": ["./worker-configuration.d.ts"],
    "noEmit": true,
    "paths": {
      "virtual:teenybase": ["./teenybase"]
    }
  },
  "include": ["src/**/*.ts", "teenybase.ts", "worker-configuration.d.ts"]
}
