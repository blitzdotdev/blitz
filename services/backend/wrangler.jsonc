{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blitz-backend",
  "account_id": "d25a778b256fb6ef6eea554d77c40f27",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "rules": [
    { "type": "Text", "globs": ["**/*.md", "**/*.txt"], "fallthrough": true }
  ],
  "dev": { "port": 8787 },
  "vars": {
    "APP_DOMAIN": "app.blitz.dev",
    "GATEWAY_ORIGIN": "https://blitz-game-gateway.blitzapp.workers.dev",
    "MAX_BLOB_BYTES": "104857600",
    "MAX_GAME_BYTES": "524288000",
    "ANON_TTL_HOURS": "12",
    "RELEASE_RETENTION": "10",
    "BLOB_GRACE_SECONDS": "86400",
    "RECONCILE_BATCH": "500",
    "REQUIRE_REGISTERED_RUNTIME": "false",
    "GOOGLE_CLIENT_ID": "118090436804-rqddo4q5qof92bejmslrrtglnrtb23k1.apps.googleusercontent.com",
    "RESPOND_WITH_ERRORS": "false",
    "RESPOND_WITH_QUERY_LOG": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blitz-games-platform-db",
      "database_id": "a6bc6a7c-aed6-4072-a1ef-35b86cc1ac13",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "blitz-games-blobs" }
  ],
  "kv_namespaces": [
    {
      "binding": "ANON_TRIPWIRE",
      "id": "33977401172a43a6a5b803022594421b",
      "preview_id": "33977401172a43a6a5b803022594421b"
    }
  ],
  "ratelimits": [
    {
      "name": "ANON_RL_IP",
      "namespace_id": "2001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "ANON_RL_ASN",
      "namespace_id": "2002",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "triggers": { "crons": ["* * * * *", "*/10 * * * *", "0 0 * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
