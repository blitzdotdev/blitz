{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blitz-backend",
  "account_id": "d25a778b256fb6ef6eea554d77c40f27",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // DO NOT DEPLOY this file until blitz.dev is detached from the teenybase workers.
  "routes": [
    { "pattern": "blitz.dev/api/*", "zone_name": "blitz.dev" }
  ],
  "vars": {
    "APP_DOMAIN": "app.blitz.dev",
    "GATEWAY_ORIGIN": "https://app.blitz.dev",
    "MAX_BLOB_BYTES": "104857600",
    "MAX_GAME_BYTES": "524288000",
    "ANON_TTL_HOURS": "12",
    "RESPOND_WITH_ERRORS": "false",
    "RESPOND_WITH_QUERY_LOG": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blitz-games-platform-db",
      "database_id": "a6bc6a7c-aed6-4072-a1ef-35b86cc1ac13",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "blitz-games-blobs" }
  ],
  "kv_namespaces": [
    { "binding": "ANON_TRIPWIRE", "id": "33977401172a43a6a5b803022594421b" }
  ],
  "ratelimits": [
    { "name": "ANON_RL_IP", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ANON_RL_ASN", "namespace_id": "2002", "simple": { "limit": 100, "period": 60 } }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } }
}
